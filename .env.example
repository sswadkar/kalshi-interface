ENV=DEMO
DRY_RUN=true
EVENT_TICKER=
DEMO_KEYID=
DEMO_KEYFILE=/absolute/path/outside/the/repository/demo-private-key.pem
# Production credentials are optional and are only used with ENV=PROD.
PROD_KEYID=
PROD_KEYFILE=
# Optional: directory containing existing JSON configuration/history files.
# It must exist. The default is the repository root for migration compatibility.
# KALSHI_DATA_DIR=/absolute/path/to/runtime-data
