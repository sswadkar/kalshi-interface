ENV=DEMO
# Manual + arbitrage simulation. Omitted or empty also means true.
DRY_RUN=true
EVENT_TICKER=
DEMO_KEYID=
DEMO_KEYFILE=/absolute/path/outside/the/repository/demo-private-key.pem
# Production credentials are optional and are only used with ENV=PROD.
PROD_KEYID=
PROD_KEYFILE=
# Optional: directory where settings (e.g. arbitrage groups) are saved.
# It must exist. The default is the repository root.
# KALSHI_DATA_DIR=/absolute/path/to/runtime-data
# Optional: host names your browser uses to reach the server (comma-separated).
# Requests addressed to any other name are rejected (DNS-rebinding protection).
# KALSHI_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional: client-side request budgets. Defaults stay under Kalshi's Basic tier
# (20 reads/s, 10 writes/s, balance 1/s); raise them only for a higher API tier.
# KALSHI_READS_PER_SECOND=15
# KALSHI_WRITES_PER_SECOND=8
# KALSHI_LOG_LEVEL=INFO
