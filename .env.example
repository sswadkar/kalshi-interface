# Credentials and deployment values. App settings live in config.json
# (copy config.example.json), saved in the data directory.
ENV=DEMO
DEMO_KEYID=
DEMO_KEYFILE=/absolute/path/outside/the/repository/demo-private-key.pem
# Production credentials are optional and are only used with ENV=PROD.
PROD_KEYID=
PROD_KEYFILE=
# Optional: existing directory for config.json and saved settings
# (e.g. arbitrage groups). The default is the repository root.
# KALSHI_DATA_DIR=/absolute/path/to/runtime-data
