**/*.egg-info
.pytest_cache
.ruff_cache
tests
scripts
.env
.env.*
.envrc
.aws
api_keys
*.pem
*.key
*.p12
*.pfx
arbitrage_groups.json
config.json
*_config.json
data
logs
*.log
*.ipynb
.DS_Store
